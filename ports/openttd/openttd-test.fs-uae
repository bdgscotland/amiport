# FS-UAE configuration for testing OpenTTD AmigaOS port
#
# Uses A3000 model for 32-bit addressing (needed for 28MB binary +
# 5MB OpenGFX + game data). A1200 can't address >24-bit.

amiga_model = A3000
cpu = 68030
fpu_model = 68882
cpu_speed = max
# Enable full FPU emulation including unimplemented instructions
# (FS-UAE default is "fast no unimplemented" which traps on F207, F4xx etc.)
fpu_strict = 1
fpu_no_unimplemented = 0

# Kickstart 3.1 ROM (A4000 ROM works on A3000)
kickstart_file = $BASE/Kickstarts/kick3.1-a4000.rom

# System hard drive — bootable Workbench 3.1
hard_drive_0 = $CONFIG/../../build/system
hard_drive_0_label = System
hard_drive_0_priority = 1

# Mount build output as WORK: — OpenTTD binary + data here
hard_drive_1 = $CONFIG/../../build/amiga
hard_drive_1_label = WORK

# Memory — OpenTTD needs ~40MB minimum (28MB binary + baseset + game state)
fast_memory = 8192
zorro_iii_memory = 65536
cpu_24bit_addressing = 0

# Keyboard
keyboard_input_grab = 1
raw_input = 0
joystick_port_1_mode = nothing

# Window size
window_width = 800
window_height = 600
