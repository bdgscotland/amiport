+# Makefile.config for amiport NetSurf-Vampire Phase 1.
+# REPLACES the netsurf-mui upstream author's config (preserved at
+# Makefile.config.upstream-author). All toolchain vars (CC, AR,
+# GCCSDK_INSTALL_*, PKG_CONFIG_PATH, CFLAGS, LDFLAGS) come from the
+# wrapper Makefile env. This file ONLY sets feature flags.
+
+# === Image format support ===
+override NETSURF_USE_PNG  := YES
+override NETSURF_USE_JPEG := YES
+override NETSURF_USE_BMP  := YES
+override NETSURF_USE_GIF  := YES
+override NETSURF_USE_NSSVG := NO
+override NETSURF_USE_RSVG  := NO
+
+# === Network / TLS ===
+override NETSURF_USE_CURL    := YES
+override NETSURF_USE_OPENSSL := NO
+override NETSURF_USE_AMISSL  := NO
+
+# === I18N (no libutf8proc on amiport) ===
+override NETSURF_USE_UTF8PROC      := NO
+override NETSURF_USE_LIBICONV_PLUG := NO
+
+# === Scripting (no Duktape; libnix has no pthreads) ===
+override NETSURF_USE_DUKTAPE := NO
 
