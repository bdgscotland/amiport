# lib/libparserutils/Makefile -- NetSurf parser primitives library
#
# Upstream: https://github.com/netsurf-browser/libparserutils @ commit
# 6b0cbf0 (v0.2.x). Copyright 2007-8 J-M Bell, MIT-licensed
# (see COPYING).
#
# 15 .c files, ~3.5K LOC + ~3.5K LOC header / generated tables.
# Subsystems:
#   - charset/ : built-in codecs (8859, ascii, ext8, utf8, utf16) + aliases + MIB-enum
#   - input/   : inputstream + filter (charset conversion frontend)
#   - utils/   : buffer, stack, vector, errors, endian helpers
#
# Source-analyzer audit verdict: CLEAN (2026-05-02). No source patches.
#
# Required by: libcss, libdom, libhubbub (Phase D-prime Wave 2).
#
# CPU TARGET POLICY: -m68040 -m68881 (matches NetSurf-Vampire dep stack
# convention; see lib/libwapcaplet/Makefile header for the rationale).
#
# WITHOUT_ICONV_FILTER (CRITICAL): switches src/input/filter.c from
# iconv-based charset conversion to libparserutils' OWN built-in codec
# subsystem. AmigaOS has no iconv; the codec subsystem is complete and
# covers UTF-8 / UTF-16 / ISO-8859-* / ASCII / ext8 vendor variants.
#
# aliases.inc PRE-BUILT: the file lib/libparserutils/src/charset/aliases.inc
# is generated by upstream's `perl build/make-aliases.pl` from
# build/Aliases. We commit the generated 1142-line .inc so the amiport
# build doesn't depend on Perl. Re-generate from upstream tarball if
# the alias list ever needs refreshing.

TOOLCHAIN_BIN = ../../toolchain/scripts
CC            = $(TOOLCHAIN_BIN)/m68k-amigaos-gcc
AR            = $(TOOLCHAIN_BIN)/m68k-amigaos-ar
RANLIB        = $(TOOLCHAIN_BIN)/m68k-amigaos-ranlib

# -O1 promoted whole-archive 2026-05-02 after perf-optimizer audit:
# all 15 TUs are -O1-safe per crash-patterns #16 (no struct-by-value
# returns >8 bytes, no float math, no alignment traps). bebbo-gcc 13.3
# (the NetSurf toolchain) has stable -O1 codegen. Estimated ~30-40%
# speedup on UTF-8 decode + buffer append hot paths. Same whole-archive
# pattern as lib/libwapcaplet (single-TU promotion).
# -fno-strict-aliasing defensive (prevents aliasing-based misopts on the
# pointer-heavy byte walkers in encodings/utf8.c, codec_*.c).
# -m68040 -m68881 matches NetSurf consumer ABI.
# -std=c99 mandatory: source uses bool, uint*_t, static inline.
# -DWITHOUT_ICONV_FILTER activates built-in codec dispatch (no iconv).
# -DNDEBUG strips inputstream.h inline-helper VERBOSE/RANDOMIZE paths.
# -D_DEFAULT_SOURCE matches upstream Makefile.
CFLAGS  = -O1 -fno-strict-aliasing -noixemul -m68040 -m68881 -std=c99 -Wall -Wextra
CFLAGS += -DWITHOUT_ICONV_FILTER
CFLAGS += -DNDEBUG
CFLAGS += -D_DEFAULT_SOURCE
CFLAGS += -Iinclude -Isrc

TARGET = libparserutils.a

OBJS = \
    src/charset/aliases.o \
    src/charset/codec.o \
    src/charset/codecs/codec_8859.o \
    src/charset/codecs/codec_ascii.o \
    src/charset/codecs/codec_ext8.o \
    src/charset/codecs/codec_utf16.o \
    src/charset/codecs/codec_utf8.o \
    src/charset/encodings/utf16.o \
    src/charset/encodings/utf8.o \
    src/input/filter.o \
    src/input/inputstream.o \
    src/utils/buffer.o \
    src/utils/errors.o \
    src/utils/stack.o \
    src/utils/vector.o

all: $(TARGET)

$(TARGET): $(OBJS)
	$(AR) rcs $@ $^
	$(RANLIB) $@

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f $(TARGET) $(OBJS)

.PHONY: all clean
