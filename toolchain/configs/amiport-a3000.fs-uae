# FS-UAE configuration for A3000/030 development testing
#
# Faster crypto, more RAM for Dropbear SSH and heavy ports.
# Usage: fs-uae toolchain/configs/amiport-a3000.fs-uae

amiga_model = A3000
cpu_speed = max

kickstart_file = $BASE/Kickstarts/kick3.1-a3000.rom

hard_drive_0 = $CONFIG/../../build/system
hard_drive_0_label = System
hard_drive_0_priority = 1

hard_drive_1 = $CONFIG/../../build/amiga
hard_drive_1_label = WORK

keyboard_input_grab = 1
raw_input = 0
joystick_port_1_mode = nothing

# 32MB — A3000 motherboard RAM (KB units per FS-UAE docs)
motherboard_ram = 32768

bsdsocket_library = 1

window_width = 720
window_height = 568
